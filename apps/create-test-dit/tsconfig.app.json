{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "declaration": false,
        "types": ["node"]
    },
    "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx"
    ],
    "include": [
      "**/*.ts"
    ],
    "references": [
      {
        "path": "../../libs/x500-cli-config/tsconfig.lib.json"
      },
      {
        "path": "../../libs/idm/tsconfig.lib.json"
      },
      {
        "path": "../../libs/parity-schema"
      }
    ]
}
