{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "nodenext",
        "customConditions": [
            "development"
        ],
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2025",
        "module": "nodenext",
        "lib": [
            "ESNext"
        ],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "strictBindCallApply": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "paths": {
            "@wildboar/idm": [
                "./libs/idm/src/index.mts"
            ],
            "@wildboar/ldap-socket": [
                "./libs/ldap-socket/src/index.mts"
            ],
            "@wildboar/ocsp-client": [
                "./libs/ocsp-client/src/index.mts"
            ],
            "@wildboar/osi-net": [
                "./libs/osi-net/src/index.mts"
            ],
            "@wildboar/parity-schema/*": [
                "./libs/parity-schema/*"
            ],
            "@wildboar/passport-x500": [
                "./libs/passport-x500/src/index.ts"
            ],
            "@wildboar/rose-transport": [
                "./libs/rose-transport/src/index.mts"
            ],
            "@wildboar/schema-level-ii": [
                "./libs/schema-level-ii/src/index.mts"
            ],
            "@wildboar/x500-auth": [
                "./libs/x500-auth-ts/src/index.mts"
            ],
            "@wildboar/x500-cli-config": [
                "./libs/x500-cli-config/src/index.mts"
            ],
            "@wildboar/x500-client-ts": [
                "./libs/x500-client-ts/src/index.mts"
            ],
            "x500-functional-tests": [
                "./libs/x500-functional-tests/src/index.ts"
            ]
        },
        "strict": true,
        "noUncheckedSideEffectImports": true,
        "esModuleInterop": false,
        "ignoreDeprecations": "6.0"
    },
    "exclude": [
        "node_modules",
        "tmp"
    ]
}
