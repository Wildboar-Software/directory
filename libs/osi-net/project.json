{
  "name": "osi-net",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/osi-net/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc --build tsconfig.lib.json --pretty",
        "cwd": "libs/osi-net",
        "outputPath": "libs/osi-net",
        "forwardAllArgs": false
      },
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/libs/osi-net"
      }
    }
  }
}
