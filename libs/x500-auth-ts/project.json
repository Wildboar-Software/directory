{
    "name": "x500-auth-ts",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/x500-auth-ts/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/libs/x500-auth-ts",
                "main": "libs/x500-auth-ts/src/index.ts",
                "tsConfig": "libs/x500-auth-ts/tsconfig.lib.json",
                "assets": [
                    "libs/x500-auth-ts/*.md",
                    "libs/x500-auth-ts/LICENSE.txt",
                    "libs/x500-auth-ts/package.json"
                ],
                "packageJson": "libs/x500-auth-ts/package.json"
            },
            "dependsOn": [
                "rose-transport:build",
                "x500-client-ts:build"
            ]
        },
        "publish": {
            "executor": "@nx/workspace:run-commands",
            "options": {
                "command": "node tools/scripts/publish.mjs x500-auth-ts {args.ver} {args.tag}"
            },
            "dependsOn": [
                {
                    "target": "build"
                }
            ]
        }
    }
}
