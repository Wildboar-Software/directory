{
    "name": "rose-transport",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/rose-transport/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": [
                "{projectRoot}/dist"
            ],
            "options": {
                "command": "tsc --build tsconfig.lib.json --pretty",
                "cwd": "libs/rose-transport",
                "outputPath": "libs/rose-transport",
                "forwardAllArgs": false
            },
            "dependsOn": [
                {
                    "target": "build",
                    "dependencies": true
                }
            ]
        },
        "publish": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/publish.mjs rose-transport {args.ver} {args.tag}"
            },
            "dependsOn": [
                {
                    "target": "build"
                }
            ]
        }
    }
}
