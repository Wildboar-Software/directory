{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.mts"
    ],
    "exclude": [
        "src/**/*.spec.mts",
        "src/**/*.test.mts",
        "src/**/*.denotest.mts"
    ],
    "references": []
}
