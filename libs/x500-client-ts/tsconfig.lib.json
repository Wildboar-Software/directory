{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "declaration": true,
        "types": ["node"],
        "paths": {
            "@wildboar/idm": ["../../dist/libs/idm/src/index.d.ts"],
            "@wildboar/osi-net": ["../../dist/libs/osi-net/src/index.d.ts"],
            "@wildboar/rose-transport": ["../../dist/libs/rose-transport/src/index.d.ts"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx"
    ]
}
