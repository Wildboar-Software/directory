{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/tsconfig.lib.tsbuildinfo",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "types": [
            "node"
        ],
        // Dependents resolve through workspace package exports, not source paths.
        "paths": {}
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx"
    ],
    "references": [
        {
            "path": "../idm/tsconfig.lib.json"
        },
        {
            "path": "../osi-net/tsconfig.lib.json"
        },
        {
            "path": "../rose-transport/tsconfig.lib.json"
        }
    ]
}
